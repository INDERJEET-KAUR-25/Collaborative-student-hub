# ==========================================
# 1. Environment & Sensitive Credentials
# ==========================================
# Secret keys, MySQL passwords, and API configurations
*.env
.env
.env.local
.env.*.local
backend/config/local_settings.py

# Local SQLite databases (if used during early development before MySQL)
*.sqlite3
*.sqlite3-journal

# ==========================================
# 2. Django Backend & Python
# ==========================================
# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments
venv/
.venv/
env/
.env/
ENV/

# Django Dynamic & User Uploaded Files
# (e.g., Student Resumes, Project Attachments, Profile Avatars)
backend/media/
backend/staticfiles/
media/
staticfiles/

# Python packaging & builds
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs & Testing
*.log
logs/
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 3. Frontend (HTML / CSS / JS / Node Dependencies)
# ==========================================
# Node modules (if using npm/yarn for frontend packages, icons, or live servers)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs & source maps
frontend/dist/
frontend/build/
*.css.map
*.js.map

# Tooling Caches (Vite, Parcel, VS Code live extensions)
.cache/
.parcel-cache/

# ==========================================
# 4. OS & Code Editor Files
# ==========================================
# Operating System temporary files
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Code Editors (VS Code, PyCharm, WebStorm)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~